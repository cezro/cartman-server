// ╔══════════════════════════════════════════════════════════════════════════╗
// ║ Cartman Server — Prisma Schema                                          ║
// ║ Mirrors cartman-mobile/supabase/migrations/20260630000100_schema.sql    ║
// ╚══════════════════════════════════════════════════════════════════════════╝
//
// Money is stored as BigInt centavos (₱99.00 = 9900).
// Column names match the existing DB exactly.
//
// ╔══════════════════════════════════════════════════════════════════════════╗
// ║ DO NOT RUN `prisma db push` AGAINST A DATABASE ANYONE ELSE USES.        ║
// ╚══════════════════════════════════════════════════════════════════════════╝
//
// This file is a *mirror*, never a source. cartman-mobile's
// supabase/migrations/*.sql is the only thing allowed to change DDL.
//
// On 2026-08-20 four objects were found missing from CartmanPH while their
// migrations were still recorded as applied: `merchants.busy_until`,
// `push_outbox`, `order_messages`, and the policies+grants on
// `incident_reports` / `verification_events`. Two of those were live
// outages — `place_order` raised "column m.busy_until does not exist" on
// every food and grocery order, and the `orders` push triggers raised on
// every insert and status update. See cartman-mobile
// supabase/migrations/20260820000100_restore_objects_lost_to_schema_drift.sql
//
// `db push` drops whatever is not in this file and writes nothing to
// `_prisma_migrations`, which is exactly the trace that was left. It ran on
// every deploy — `render.yaml` carried
// `preDeployCommand: npx prisma db push --accept-data-loss` with
// `autoDeployTrigger: commit` — so the wipe was automated, not a slip.
// That line is gone; the deploy no longer touches DDL.
//
// `npm run db:drift` keeps this mirror honest, but only for what Prisma can
// model: **tables, columns and enums.** It is blind to policies, grants,
// triggers, functions and indexes — which is to say, blind to the fourth item
// in the list above. A green drift run means `db push` would not drop a table
// or a column; it says nothing about who can read what. For that, and for
// anything else this file cannot express — `menu_items.search_tsv` and its GIN
// index, `push_outbox`'s partial index, the `rider_wallet_balance` view —
// cartman-mobile's supabase/migrations/ is the only authority.
//
// Provisioning a *fresh* database: apply the Supabase migrations, in order,
// and nothing else. They create what `db push` cannot — `order_ref_seq`
// and its trigger, every RLS policy, every trigger, every grant, the
// `search_tsv` generation expression, the `rider_wallet_balance` view.
//
// Keeping this file honest: `npm run db:drift` diffs it against a live
// database and exits non-zero on any difference. Run it after every migration
// applied in cartman-mobile.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums (mirror models/enums.dart .wire values) ───────────────────────

enum order_status {
  pending
  preparing
  ready_for_pickup
  accepted
  arrived_at_merchant
  picked_up
  in_transit
  delivered
  canceled
  // Attempted and failed, as opposed to `canceled` — a decision someone made,
  // usually before the goods moved. The two differ for money and for blame: on
  // COD the rider holds goods nobody paid for and collected nothing; on prepaid
  // the customer's money is already taken. Listed last to mirror the DB, where
  // `alter type ... add value` appends (20260809000100 in cartman-mobile).
  delivery_failed
}

// Why the delivery failed. A closed enum rather than free text because the
// reason decides who bears the cost, and that is not a question to answer by
// parsing a sentence a rider typed at a gate in the rain. `orders.canceled_reason`
// carries the rider's optional note alongside it.
enum delivery_failure_reason {
  customer_unreachable // nobody answering: door, phone, or chat
  wrong_address // address does not exist / pin is not the place
  customer_refused // reached, and declined to take it
  unsafe_location // rider judged the drop-off unsafe to approach
}

enum order_type {
  food
  grocery
  errand
  pickup_delivery
  ride
  multi_stop
}

// How the rider should hand the order over (20260803000300 in cartman-mobile).
// An enum rather than free text because the rider screen renders it as an
// instruction to act on; `orders.dropoff_note` carries the specifics
// ("green gate, second floor").
enum dropoff_instruction {
  hand_to_me
  leave_at_door
  meet_at_gate
  meet_outside
}

enum payment_method {
  cod
  gcash
  maya
  card
  cart_credits
}

enum wallet_txn_type {
  credit_remittance
  debit_cod_order
  credit_delivery_reward
  debit_commission
}

enum incident_kind {
  accident
  harassment
  theft
  vehicle
  unsafe_area
  other
}

enum incident_status {
  open
  acknowledged
  closed
}

// ── profiles — identity, extends auth.users ─────────────────────────────

model profiles {
  id              String   @id @db.Uuid
  full_name       String   @default("")
  phone           String?  @unique
  phone_verified  Boolean  @default(false)
  role            String   @default("customer") // 'customer' | 'rider' | 'merchant'
  avatar_url      String?
  membership_tier String   @default("Bronze")
  cart_points     BigInt   @default(0)
  wallet_centavos BigInt   @default(0)
  // Admin Dashboard V2 ban/unban flag (POST /admin/users/:id/toggle-status,
  // /bypass-auth). Distinct from riders.is_active, which is duty on/off.
  suspended       Boolean  @default(false)
  created_at      DateTime @default(now()) @db.Timestamptz()

  // Account deletion (H13/L5). `delete_my_account()` tombstones the profile
  // and stamps these; the auth.users row still has to be swept server-side
  // with the service role, or the credentials keep working.
  deleted_at      DateTime? @db.Timestamptz()
  deletion_reason String?

  // Stamped by the account-deletion sweep once the auth.users row is confirmed
  // gone. Null while the profile is tombstoned but the credentials still work.
  // `profiles` has no FK to auth.users, so this is the only thing that tells
  // the sweep it is finished with a row (20260807000100).
  auth_deleted_at DateTime? @db.Timestamptz()

  // Relations
  addresses                 addresses[]
  orders_as_customer        orders[]                  @relation("customer_orders")
  orders_as_rider           orders[]                  @relation("rider_orders")
  rider                     riders?
  device_tokens             device_tokens[]
  otp_codes                 otp_codes[]
  merchant_users            merchant_users[]
  ratings_given             order_ratings[]           @relation("customer_ratings")
  ratings_received          order_ratings[]           @relation("rider_ratings")
  rider_assignment_events   order_assignment_events[] @relation("rider_assignment_events")
  actor_assignment_events   order_assignment_events[] @relation("actor_assignment_events")
  incident_reports_filed    incident_reports[]        @relation("reporter_incidents")
  verification_events_acted verification_events[]     @relation("actor_verifications")
  push_outbox               push_outbox[]
  order_messages_sent       order_messages[]
}

// ── addresses — saved Home / Work / Current (C-6.2) ─────────────────────

model addresses {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String   @db.Uuid
  label        String   @default("")
  text_address String
  lat          Float
  lng          Float
  is_default   Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamptz()

  // Relations
  profile profiles @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

// ── merchants + menu ────────────────────────────────────────────────────

model merchants {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  category        String    @default("")
  rating          Decimal   @default(0)
  delivery_fee    BigInt    @default(0)
  min_order       BigInt    @default(0)
  eta_minutes     Int       @default(0)
  is_open         Boolean   @default(true)
  is_verified     Boolean   @default(false)
  image_url       String?
  promo_text      String?
  // Store pin (WGS84) — customer-app "near you" sort; null = unknown.
  // Mirrors supabase/migrations/20260723000100_merchant_geo.sql.
  lat             Float?
  lng             Float?
  // Weekly windows: [{"day":0-6,"open":"HH:MM","close":"HH:MM"}, …].
  // Informational in Phase 1 — is_open is still the single availability flag.
  operating_hours Json      @default("[]")
  // Paused for new orders until this moment; null or past = trading normally.
  // A timestamp rather than an `is_busy` flag so the pause expires on its own
  // — a flag gets switched on at the Saturday peak and off never.
  // `is_open` stays the separate "trading at all" switch: a closed store is
  // not busy, it is closed. Mirrors 20260818000100_merchant_busy_until.sql.
  busy_until      DateTime? @db.Timestamptz()
  created_at      DateTime  @default(now()) @db.Timestamptz()

  // Relations
  menu_items     menu_items[]
  orders         orders[]
  merchant_users merchant_users[]
  order_ratings  order_ratings[]
}

model menu_items {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchant_id String  @db.Uuid
  name        String
  price       BigInt  @default(0)
  category    String  @default("")
  in_stock    Boolean @default(true)
  description String?
  modifiers   Json    @default("[]")

  // Dish search (20260818000200_menu_item_search.sql). In the database this is
  // `generated always as (to_tsvector('simple', name || description ||
  // category)) stored`, with a GIN index over it.
  //
  // Prisma can express neither the tsvector type, the generation expression,
  // nor a GIN index — so this line exists **only** so the column is not seen
  // as unknown and dropped. `Unsupported` fields are not selectable from the
  // client, which is correct here: nothing in this server reads it, and the
  // search that does runs in the database.
  //
  // Because the expression and the index cannot be mirrored, a `db push`
  // would still damage this column even with this line present. That is one
  // of the reasons `db push` is banned outright at the top of this file.
  search_tsv Unsupported("tsvector")?

  // Relations
  merchant    merchants     @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  order_items order_items[]

  @@index([merchant_id])
}

// ── orders — central table for ALL order types ──────────────────────────

model orders {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ref_no            String?        @unique
  customer_id       String         @db.Uuid
  assigned_rider_id String?        @db.Uuid
  type              order_type
  status            order_status   @default(pending)
  merchant_id       String?        @db.Uuid
  merchant_name     String?
  payment           payment_method @default(cod)

  // Geocoded endpoints
  pickup_lat   Float?
  pickup_lng   Float?
  pickup_text  String?
  dropoff_lat  Float?
  dropoff_lng  Float?
  dropoff_text String?

  // How to hand it over, and the free-text specifics. NOT NULL with a default
  // in the DB, so an order that says nothing still means hand-it-to-me.
  dropoff_instruction dropoff_instruction @default(hand_to_me)
  dropoff_note        String?

  // Money (centavos)
  subtotal        BigInt @default(0)
  delivery_fee    BigInt @default(0)
  discount        BigInt @default(0)
  total           BigInt @default(0)
  delivery_payout BigInt @default(0)

  // Free-form payloads
  errand_payload  Json?
  notes           String?
  merchant_notes  String?
  rider_notes     String?
  recipient_name  String?
  recipient_phone String?

  // Completion. `delivered_at` is the server clock stamped on the real
  // in_transit → delivered transition, set once and never by the client — a
  // completion time on a cash order is a number someone has a reason to shade.
  // Both this server's advanceRiderStatus and the advance_order_status RPC
  // write it; they are parallel implementations of the same transition
  // (20260803000300 in cartman-mobile), so they have to agree.
  delivered_at DateTime? @db.Timestamptz()

  // When the merchant expects this order to be cooked — the first ETA the
  // customer sees that is not a guess. Written only by the
  // `merchant_set_prep_time` RPC (20260818000300_order_prep_time.sql), which
  // clamps the minutes to a range; a plain column grant would have let the
  // panel write any instant, including one already past.
  prep_ready_by DateTime? @db.Timestamptz()

  // Proof of delivery, written only by the rider_submit_pod RPC, which the
  // rider app calls directly over Supabase. Present here so Prisma can read
  // them back — without the fields they are simply invisible to this server
  // rather than an error, which is the harder kind of drift to notice.
  pod_photo_url String?
  pod_note      String?

  // Cancellation — set by merchant_reject_order / customer / admin
  canceled_reason String?
  canceled_by     String? // 'merchant' | 'customer' | 'admin' | 'rider'

  // Delivery failure. Written only by the rider_report_delivery_failed RPC,
  // which the rider app calls directly over Supabase — cartman-server does not
  // own this transition, it only has to read it without throwing.
  // `delivery_failed_at` is the server clock: a failure time on a cash order is
  // a number someone has a reason to shade.
  delivery_failure_reason delivery_failure_reason?
  delivery_failed_at      DateTime?                @db.Timestamptz()

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @default(now()) @db.Timestamptz()

  // Relations
  customer            profiles                    @relation("customer_orders", fields: [customer_id], references: [id])
  rider               profiles?                   @relation("rider_orders", fields: [assigned_rider_id], references: [id])
  merchant            merchants?                  @relation(fields: [merchant_id], references: [id])
  order_items         order_items[]
  order_stops         order_stops[]
  rider_locations     rider_locations[]
  wallet_transactions rider_wallet_transactions[]
  order_rating        order_ratings?
  assignment_events   order_assignment_events[]
  incident_reports    incident_reports[]          @relation("order_incidents")
  order_messages      order_messages[]

  @@index([customer_id])
  @@index([assigned_rider_id])
  @@index([status])
}

// ── order_items — structured food/grocery lines ─────────────────────────

model order_items {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id     String  @db.Uuid
  menu_item_id String? @db.Uuid
  name         String
  qty          Int     @default(1)
  unit_price   BigInt  @default(0)
  modifiers    Json    @default("[]")

  // Relations
  order     orders      @relation(fields: [order_id], references: [id], onDelete: Cascade)
  menu_item menu_items? @relation(fields: [menu_item_id], references: [id])

  @@index([order_id])
}

// ── order_stops — Multi-Stop Builder ────────────────────────────────────

model order_stops {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id String @db.Uuid
  seq      Int    @default(0)
  kind     String @default("deliver")
  label    String @default("")
  lat      Float  @default(0)
  lng      Float  @default(0)
  payload  Json?

  // Relations
  order orders @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
}

// ── order_messages — customer ↔ rider chat (H6) ─────────────────────────
//
// Mirrors 20260803000300_delivery_pod_chat.sql, as narrowed by
// 20260806000200_tighten_client_grants.sql.
//
// **Nothing in this server reads or writes it.** Both apps talk to Supabase
// directly for chat, over Realtime. It is modelled here for one reason: so
// that Prisma knows the table exists. It did not, and on 2026-08-20 the table
// was found missing from CartmanPH with its migration still recorded as
// applied — chat had no storage at all. See the banner at the top of this file.
//
// `authenticated` holds INSERT on (order_id, sender_id, body) only; the
// remaining columns are database-generated on purpose, so a client cannot
// backdate a message or forge an id.

model order_messages {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id   String   @db.Uuid
  sender_id  String   @db.Uuid
  body       String
  created_at DateTime @default(now()) @db.Timestamptz()

  // Relations
  order  orders   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  sender profiles @relation(fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([order_id, created_at])
}

// ── order_ratings — rate & review, one per order (C-7.x) ────────────────
// Mirrors cartman-mobile's supabase/migrations/20260719000200_order_ratings.sql
// (table + RLS + rate_order RPC — the DB twin of POST /orders/:id/rating).
// The 1..5 star range and the at-least-one-score rule are DB CHECK
// constraints (not expressible here; the migration is the DDL source of
// truth). merchants.rating / riders.rating are platform-owned aggregates
// recomputed from these rows — never client-written. Note rider_id
// references profiles (like orders.assigned_rider_id), not riders.

model order_ratings {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id       String   @unique @db.Uuid
  customer_id    String   @db.Uuid
  merchant_id    String?  @db.Uuid
  rider_id       String?  @db.Uuid
  merchant_stars Int?
  rider_stars    Int?
  comment        String?
  created_at     DateTime @default(now()) @db.Timestamptz()

  // Relations
  order         orders     @relation(fields: [order_id], references: [id], onDelete: Cascade)
  customer      profiles   @relation("customer_ratings", fields: [customer_id], references: [id], onDelete: Cascade)
  merchant      merchants? @relation(fields: [merchant_id], references: [id], onDelete: SetNull)
  rider_profile profiles?  @relation("rider_ratings", fields: [rider_id], references: [id], onDelete: SetNull)

  @@index([merchant_id])
  @@index([rider_id])
}

// ── riders — rider state (R-4.2) ────────────────────────────────────────

model riders {
  id                String   @id @db.Uuid
  is_active         Boolean  @default(false)
  vehicle           String   @default("")
  plate_no          String   @default("")
  rating            Decimal  @default(5.0)
  acceptance_rate   Decimal  @default(1.0)
  total_trips       Int      @default(0)
  broadcast_count   Int      @default(0)
  avg_duration_secs Int      @default(0)
  // Set true by POST /admin/verifications/:id/approve when the approved
  // verification's user has a riders row (COD ID / permit check).
  is_verified       Boolean  @default(false)
  updated_at        DateTime @default(now()) @db.Timestamptz()

  // Relations
  profile             profiles                    @relation(fields: [id], references: [id], onDelete: Cascade)
  rider_locations     rider_locations[]
  wallet_transactions rider_wallet_transactions[]
}

// ── rider_locations — background telemetry (R-2.1) ──────────────────────

model rider_locations {
  id          BigInt   @id @default(autoincrement())
  rider_id    String   @db.Uuid
  lat         Float
  lng         Float
  order_id    String?  @db.Uuid
  recorded_at DateTime @default(now()) @db.Timestamptz()

  // Relations
  rider riders  @relation(fields: [rider_id], references: [id], onDelete: Cascade)
  order orders? @relation(fields: [order_id], references: [id])

  @@index([rider_id, recorded_at(sort: Desc)])
}

// ── rider_wallet_transactions — APPEND-ONLY ledger (R-3.1) ──────────────

model rider_wallet_transactions {
  id         BigInt          @id @default(autoincrement())
  rider_id   String          @db.Uuid
  type       wallet_txn_type
  amount     BigInt
  order_id   String?         @db.Uuid
  created_at DateTime        @default(now()) @db.Timestamptz()

  // Relations
  rider riders  @relation(fields: [rider_id], references: [id], onDelete: Cascade)
  order orders? @relation(fields: [order_id], references: [id])

  @@index([rider_id, created_at(sort: Desc)])
}

// ── device_tokens — FCM push targets (C-4.2) ────────────────────────────

model device_tokens {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  token      String
  platform   String   @default("android")
  updated_at DateTime @default(now()) @db.Timestamptz()

  // Relations
  profile profiles @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, token])
  @@index([user_id])
}

// ── push_outbox — the L3 notification queue ─────────────────────────────
//
// Mirrors cartman-mobile/supabase/migrations/20260810000200_push_outbox.sql
// exactly. Six triggers there decide who to notify and insert a row;
// PushDrainService reads it and posts each to the `push-send` Edge Function.
//
// The table is service-role only: RLS is enabled with **no policies** and all
// privileges are revoked from anon and authenticated. So this model is only
// ever reachable through this server's own Prisma connection — a
// request-scoped or anon client reads zero rows and reports success, which is
// exactly the "failed upward" shape the POD grant had.

model push_outbox {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  // Which trigger produced this, so a misfiring rule can be found by querying
  // rather than by reading six functions.
  event      String
  title      String
  body       String?
  data       Json      @default("{}")
  created_at DateTime  @default(now()) @db.Timestamptz()
  sent_at    DateTime? @db.Timestamptz()
  attempts   Int       @default(0)
  last_error String?

  // Relations
  profile profiles @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // Partial in the database (`where sent_at is null`) — Prisma cannot express
  // that, and declaring it unqualified here would drift the schema. The index
  // that actually exists is the migration's; this line only keeps `db push`
  // from proposing to drop it.
  @@index([created_at])
}

// ── otp_codes — transactional SMS + email OTP (C-1.2) ───────────────────

model otp_codes {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone      String?
  email      String?
  channel    String   @default("sms")
  code_hash  String
  user_id    String?  @db.Uuid
  expires_at DateTime @db.Timestamptz()
  consumed   Boolean  @default(false)
  attempts   Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz()

  // Relations
  profile profiles? @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([phone, created_at(sort: Desc)])
  @@index([email, created_at(sort: Desc)])
}

// ── merchant_users — Merchant Panel identity (20260707000100_merchant_panel.sql) ─
// Links auth users to the stores they manage. RLS policies on orders,
// order_items, merchants, and menu_items reference this table — do NOT
// remove it from schema.prisma or prisma db push will try to drop it,
// breaking those policies.

model merchant_users {
  merchant_id String   @db.Uuid
  user_id     String   @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz()

  // Relations
  merchant merchants @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  profile  profiles  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([merchant_id, user_id])
  @@index([user_id])
}

// ── Admin Dashboard V2 — admin/server-only tables ────────────────────────
// RLS is enabled on all four with NO policies (see the migration): the
// server writes to them via its own DB connection (DIRECT_URL /
// DATABASE_URL), same posture as other write-only tables. Mobile apps never
// read these directly.

// ── incidents — operational issue / system alert log ────────────────────

model incidents {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          String
  severity      String
  status        String   @default("Open") // Enum: Open, Investigating, Resolved
  related_order String?
  assignee      String?
  reported_at   DateTime @default(now()) @db.Timestamptz()
}

// ── verifications — COD ID / Merchant Business Permit review queue ──────

model verifications {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String   @db.Uuid
  document_type String
  document_url  String
  status        String   @default("Pending") // Enum: Pending, Approved, Rejected
  submitted_at  DateTime @default(now()) @db.Timestamptz()
}

// ── tickets — multi-channel support requests ─────────────────────────────

model tickets {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  category   String // General, Dispute, Technical, Billing
  subject    String
  priority   String   @default("Low") // Low, Medium, High
  status     String   @default("Open") // Open, In Progress, Closed
  created_at DateTime @default(now()) @db.Timestamptz()
}

// ── global_config — dynamic business logic variables (singleton row) ────
// Store-and-serve only in Phase 1 — NOT wired into live delivery-fee /
// commission calculation (out of scope for Admin Dashboard V2; see
// AdminConfigService for the same note at the call site).

model global_config {
  id                      Int      @id @default(1) // Singleton
  base_rate               Decimal  @default(39.0)
  base_radius             Decimal  @default(2.0)
  surcharge_per_km        Decimal  @default(15.0)
  strike_limit            Int      @default(3)
  auto_assign             Boolean  @default(true)
  pro_exposure_multiplier Decimal  @default(2.0)
  allow_ads               Boolean  @default(true)
  updated_at              DateTime @default(now()) @updatedAt @db.Timestamptz()
}

// ── order_assignment_events — audit log for rider claim/release actions ──

model order_assignment_events {
  id         BigInt   @id @default(autoincrement())
  order_id   String   @db.Uuid
  rider_id   String?  @db.Uuid
  action     String
  reason     String?
  actor_id   String?  @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz()

  order orders    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  rider profiles? @relation("rider_assignment_events", fields: [rider_id], references: [id])
  actor profiles? @relation("actor_assignment_events", fields: [actor_id], references: [id])

  @@index([order_id, created_at])
  @@index([rider_id, created_at(sort: Desc)])
}

// ── incident_reports — user safety and incident reports (H11) ────────────

model incident_reports {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporter_id String          @db.Uuid
  order_id    String?         @db.Uuid
  kind        incident_kind
  note        String
  lat         Float?
  lng         Float?
  status      incident_status @default(open)
  resolution  String?
  created_at  DateTime        @default(now()) @db.Timestamptz()
  updated_at  DateTime        @default(now()) @updatedAt @db.Timestamptz()

  reporter profiles @relation("reporter_incidents", fields: [reporter_id], references: [id], onDelete: Cascade)
  order    orders?  @relation("order_incidents", fields: [order_id], references: [id], onDelete: SetNull)

  @@index([reporter_id, created_at(sort: Desc)])
}

// ── verification_events — admin audit log for rider/merchant vetting ─────

model verification_events {
  id           BigInt   @id @default(autoincrement())
  subject_kind String
  subject_id   String   @db.Uuid
  approved     Boolean
  actor_id     String   @db.Uuid
  reason       String?
  created_at   DateTime @default(now()) @db.Timestamptz()

  actor profiles @relation("actor_verifications", fields: [actor_id], references: [id])

  @@index([subject_kind, subject_id, created_at(sort: Desc)])
}
