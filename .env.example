# Cartman Server — copy to .env and fill. NEVER commit real values.
#
# Supabase Database (from Supabase Dashboard → Settings → Database)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# Supabase Project (from Supabase Dashboard → Settings → API)
SUPABASE_URL=https://[PROJECT].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Supabase Database Webhooks (Dashboard → Database → Webhooks → custom header
# `x-supabase-webhook-secret` on the request to POST /webhooks/supabase)
SUPABASE_WEBHOOK_SECRET=

# ── OTP delivery (C-1.2) ──────────────────────────────────────────────────────
# Provider selection.
#
# SMS defaults off the credential: Semaphore when SEMAPHORE_API_KEY is set,
# stub otherwise. That is not cosmetic — a stub does not just skip the send,
# it makes the server return the code in the API response, and /auth/send-otp
# is public. A flat "stub" default would therefore have handed out the
# verification code for any phone number on the next Render deploy, since
# Render sets no OTP_SMS_PROVIDER. assertSafeOtpConfig refuses to boot a
# production environment that resolved to the stub.
#
# Email defaults to stub: the email OTP path is dormant and public callers
# cannot reach it.
#
# To hold Semaphore deliberately (e.g. while migrating to Brevo, which does
# both SMS and email — https://developers.brevo.com/docs/getting-started),
# set OTP_SMS_PROVIDER=stub explicitly and do it outside production.
#   OTP_SMS_PROVIDER   = stub | semaphore     (default: semaphore if key set)
#   OTP_EMAIL_PROVIDER = stub | resend        (default: stub)
# OTP_SMS_PROVIDER=stub
# OTP_EMAIL_PROVIDER=stub

# Semaphore (PH SMS gateway) — required only when OTP_SMS_PROVIDER=semaphore.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=CARTMAN

# Resend (email) — required only when OTP_EMAIL_PROVIDER=resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@cartmanph.com

# Geocoding proxy for address search (GET /geo/search, /geo/reverse).
# This is the SECRET (sk.*) Mapbox token and must never leave the server —
# it is a different token from the app's public tile token. Basemap tiles come
# from CARTO and need no key at all, so this is the only map-related secret.
# Leave blank in dev: the endpoints then return empty results and the address
# form falls back to manual pin-drop rather than failing.
MAPBOX_TOKEN=

# OTP_DEV_MODE=true    # forces the stub for both channels (code returned inline) — dev only

# When migrating to Brevo: add BrevoSms/BrevoEmail providers + a 'brevo' case in
# src/auth/otp-providers.ts, then set OTP_SMS_PROVIDER=brevo / OTP_EMAIL_PROVIDER=brevo
# and BREVO_API_KEY here.
# BREVO_API_KEY=

# Phone the dev seed gives seed-customer@cartman.ph. Point it at a real handset
# to run the live-OTP smoke test (INT-13); leave unset and the seed uses an
# unreachable placeholder. Kept out of prisma/seed.ts so a personal number
# never lands in the repo.
SEED_CUSTOMER_PHONE=

# FCM Push Notifications (C-4.2) — optional in Phase 1
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=

# Server
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed origins, e.g. https://app.cartmanph.com,https://dashboard.cartmanph.com
# Use * to allow all origins (dev only — never in production)
CORS_ORIGINS=*

# SWAGGER_ENABLED=true   # forces /api/docs on even when NODE_ENV=production.
                          # Interim prod ops surface for merchant order
                          # accept/ready (spec D-2) until the merchant panel
                          # ships — keep OFF unless actively needed.

# Rider feed ranking weights (GET /orders/feed, R-1.1) — advisory ordering only.
# score = W_AGE*age_norm + W_PROX*proximity_norm + W_PAYOUT*payout_norm + W_TYPE*type_w
# age_norm: minutesSince(created_at) capped at 30min, normalized 0..1
# proximity_norm: 1 - (distance_km / 10), floored at 0; 0 when rider position unknown
# payout_norm: delivery_payout capped at ₱200 (20000 centavos), normalized 0..1
# type_w: fixed per order_type (ride 1.0, food 0.8, pickup_delivery 0.6, grocery/errand/multi_stop 0.4)
FEED_W_AGE=0.40
FEED_W_PROX=0.30
FEED_W_PAYOUT=0.20
FEED_W_TYPE=0.10
