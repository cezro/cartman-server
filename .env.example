# Cartman Server — copy to .env and fill. NEVER commit real values.
#
# Supabase Database (from Supabase Dashboard → Settings → Database)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# Supabase Project (from Supabase Dashboard → Settings → API)
SUPABASE_URL=https://[PROJECT].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Supabase Database Webhooks (Dashboard → Database → Webhooks → custom header
# `x-supabase-webhook-secret` on the request to POST /webhooks/supabase)
SUPABASE_WEBHOOK_SECRET=

# SMS OTP — Semaphore (C-1.2)
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=CARTMAN

# Email OTP — Resend (C-1.2)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@cartmanph.com

# OTP_DEV_MODE=true    # returns the OTP code in the response instead of sending SMS/email — dev only, never in prod

# FCM Push Notifications (C-4.2) — optional in Phase 1
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=

# Server
PORT=3000
NODE_ENV=development

# SWAGGER_ENABLED=true   # forces /api/docs on even when NODE_ENV=production.
                          # Interim prod ops surface for merchant order
                          # accept/ready (spec D-2) until the merchant panel
                          # ships — keep OFF unless actively needed.

# Rider feed ranking weights (GET /orders/feed, R-1.1) — advisory ordering only.
# score = W_AGE*age_norm + W_PROX*proximity_norm + W_PAYOUT*payout_norm + W_TYPE*type_w
# age_norm: minutesSince(created_at) capped at 30min, normalized 0..1
# proximity_norm: 1 - (distance_km / 10), floored at 0; 0 when rider position unknown
# payout_norm: delivery_payout capped at ₱200 (20000 centavos), normalized 0..1
# type_w: fixed per order_type (ride 1.0, food 0.8, pickup_delivery 0.6, grocery/errand/multi_stop 0.4)
FEED_W_AGE=0.40
FEED_W_PROX=0.30
FEED_W_PAYOUT=0.20
FEED_W_TYPE=0.10
